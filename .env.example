NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Switch to https://portal.monostechnology.co.uk once its DNS record exists
NEXT_PUBLIC_SITE_URL=https://monos-portal.netlify.app

# Optional: default payment links per package, attached to every new booking automatically.
PAY_LINK_RETAIL_DEPOSIT=
PAY_LINK_RETAIL_BALANCE=
PAY_LINK_LAUNCH490_DEPOSIT=https://www.paypal.com/ncp/payment/45ALR2Y4ECJXL
PAY_LINK_LAUNCH490_BALANCE=https://www.paypal.com/ncp/payment/NSVTCNUHPALVA

# Optional: Calendly (or similar) link for the 30-minute 1-1 with Aisha on the launch offer.
CALL_BOOKING_URL=https://cal.com/aisha-monos-rv64et/30min
QUESTIONS_CALL_URL=https://cal.com/aisha-monos-rv64et/15min

# Email: everything is sent from info@monos.ai. For Google Workspace use smtp.gmail.com, port 465, and an app password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=info@monos.ai
SMTP_PASS=
EMAIL_FROM="MONOS Technology <info@monos.ai>"
ADMIN_EMAIL=info@monos.ai

# Sign-up endpoint: comma-separated origins allowed to POST to /api/signup (e.g. the landing page's host). * allows any.
SIGNUP_ALLOWED_ORIGINS=*

# Website agent (builds each client's site from their consultation form)
ANTHROPIC_API_KEY=
# Netlify personal access token (User settings > Applications), and your team slug from the Netlify URL
NETLIFY_AUTH_TOKEN=
NETLIFY_ACCOUNT_SLUG=
# Any long random string; protects the worker endpoint
SITE_AGENT_SECRET=
# Portal hosted on Netlify: https://portal.monostechnology.co.uk/.netlify/functions/site-agent-background
# Portal hosted on Vercel: leave blank (uses /api/site-agent/build)
SITE_AGENT_WORKER_URL=https://monos-portal.netlify.app/.netlify/functions/site-agent-background
# Optional: free key from unsplash.com/developers, for stock photos when a client has none
UNSPLASH_ACCESS_KEY=
# Set to "off" to stop builds starting automatically when a client submits their brief
SITE_AGENT_AUTO=

# PayPal REST app (developer.paypal.com > Apps & Credentials > Live). With these set, each
# payment is a PayPal order tagged with the client's payment, and the portal marks it paid
# and unlocks the next step automatically. Without them, the PAY_LINK_* links are used and
# payments are marked paid by hand in Admin.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=live
